# Copy to .env.local and fill in.

# Neon Postgres connection string (Dashboard -> Connection Details -> "Pooled connection")
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Password to open the app.
APP_PASSWORD="change-this"

# Any long random string. Used to derive the session cookie value.
AUTH_SECRET="change-this-to-something-long-and-random"
